POSTGRES_DB=scrapy_db
POSTGRES_USER=scrapy_user
POSTGRES_PASSWORD=scrapy_pass
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

# scrapydweb UI login (leave ENABLE_AUTH=false for local-only use)
SCRAPYDWEB_ENABLE_AUTH=false
SCRAPYDWEB_USERNAME=admin
SCRAPYDWEB_PASSWORD=admin
